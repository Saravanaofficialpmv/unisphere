rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // UNISPHERE FIRESTORE SECURITY RULES
    // =========================================================================
    // 
    // Option A: Development & Demo Testing (Allows seedInitialDataIfEmpty & all reads/writes)
    // Uncomment this block while developing or testing with sample data:
    match /{document=**} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // Option B: Production Security Rules (Enforce authentication)
    // To enable strict production rules, comment out Option A above and
    // uncomment the rules below:
    // -------------------------------------------------------------------------
    /*
    // Allow authenticated users to read & write their user documents
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Announcements - public read, authenticated write
    match /announcements/{annId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Assignments, Submissions, Marks, Attendance, Exams, Leaves
    match /assignments/{docId} { allow read, write: if request.auth != null; }
    match /submissions/{docId} { allow read, write: if request.auth != null; }
    match /marks/{docId}       { allow read, write: if request.auth != null; }
    match /attendance/{docId}  { allow read, write: if request.auth != null; }
    match /exams/{docId}       { allow read, write: if request.auth != null; }
    match /leaves/{docId}      { allow read, write: if request.auth != null; }

    // Hackathons & Registrations
    match /hackathons/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /hackathons/{hackId}/registrations/{regId} { allow read, write: if request.auth != null; }
    match /hackathon_banners/{docId} { allow read: if true; allow write: if request.auth != null; }

    // Projects, Certifications, Department Metrics, Notifications, Faculties
    match /projects/{docId}          { allow read, write: if request.auth != null; }
    match /certifications/{docId}    { allow read, write: if request.auth != null; }
    match /department_metrics/{docId}{ allow read, write: if request.auth != null; }
    match /notifications/{docId}     { allow read, write: if request.auth != null; }
    match /faculties/{docId}         { allow read: if true; allow write: if request.auth != null; }
    match /students/{docId}          { allow read, write: if request.auth != null; }
    */
  }
}
