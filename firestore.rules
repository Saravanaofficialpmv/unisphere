rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────────
    // Firestore Security Rules for Syllabi Collection
    // Enforces strict student access controls on client queries
    // ──────────────────────────────────────────────────────────────────────────
    match /syllabi/{syllabusId} {
      // Admin and HOD have full management access (create, update, delete, write)
      allow write, create, update, delete: if request.auth != null && 
        (request.auth.token.role in ['admin', 'hod']);

      // Read permissions:
      // 1. HOD and Admin can read all records (Current, Previous, Future, Draft, Published)
      // 2. Students can ONLY read records where:
      //    - status == 'published' AND
      //    - effectiveStartYear <= student's current start year
      //    (Future and Draft syllabus documents are strictly blocked at the Firebase database level)
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'hod'] ||
        (
          resource.data.status == 'published' &&
          resource.data.effectiveStartYear <= request.auth.token.effectiveStartYear
        )
      );
    }
  }
}
